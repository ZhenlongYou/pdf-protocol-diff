        "heading": "29.2.3 Bit Error Ratio",
        "title": "Bit Error Ratio",
        "level": 3,
        "location": "29 CEI-112G-LINEAR-PAM4 Interface / 29.2 General CEI Requirements / 29.2.3 Bit Error Ratio",
        "number_path": [
          "29",
