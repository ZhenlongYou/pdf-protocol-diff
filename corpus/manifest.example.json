        "must_extract_new": [
          "32 CEI-224G-MR-PAM4 Medium Reach Interface",
          "6. Shall support hot plug.",
          "T_JH4.3u",
          "T_JHRMS",
          "T_EOJ03",
          "bmax(1)",
          "bmin(0)"
        ],
        "must_find": [
          "Np = 60",
          "92.5 Ω"
        ],
        "must_review": [
          "Single-ended reference resistance",
          "46.25"
        ],
        "must_ignore": [
          "Column 2=b (1)",
          "Column 2=b (0)",
          "Normalized DFE coefficient maximum limit b (1) 0.85"
        ],
        "must_ignore_locations": [
          "1. Support serial baud rates",
          "6. Shall support hot plug."
        ]
      }
    },
